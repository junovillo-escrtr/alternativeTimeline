{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LTA Saved Game",
  "type": "object",
  "required": [
    "scenario",
    "player"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\\\.\\\\d+\\\\.\\\\d+$"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "player": {
      "type": "string"
    },
    "selected": {
      "type": "string"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "created": {
      "type": "string"
    },
    "scenario": {
      "$ref": "scenario.schema.json"
    },
    "events": {
      "type": "array"
    },
    "metrics": {
      "type": "object"
    },
    "subjectMetrics": {
      "type": "object"
    },
    "countryMetrics": {
      "type": "object"
    },
    "publicEstimates": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
